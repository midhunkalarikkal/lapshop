
<%- include("../userpartials/navbar.ejs") %>

<link rel="stylesheet" href="/static/css/contact_form.css">

<section class="view contact-page">
    <div class="container">
        <div class="contact-container">
            <div class="contact-heading">
                <span class="contact-eyebrow">GET IN TOUCH</span>
                <h1>We're here to help.</h1>
                <p>
                    Have a question, feedback, or need assistance?
                    Send us a message and we'll get back to you.
                </p>
            </div>

            <div class="contact-card">
                <div class="contact-card-header">
                    <div>
                        <h2>Send us a message</h2>
                        <p>Fill in the details below to reach our team.</p>
                    </div>
                    <div class="contact-header-icon">
                        <i class="fa-regular fa-envelope"></i>
                    </div>
                </div>

                <form method="POST" id="submit-form" novalidate>
                    <div class="row g-4">
                        <div class="col-12">
                            <label for="name" class="form-label">Full name <span>*</span></label>
                            <input
                                type="text"
                                class="form-control"
                                name="name"
                                id="name"
                                placeholder="Enter your full name"
                                autocomplete="name"
                                required
                                oninput="validateName()">
                            <span id="nameError" class="field-error"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="email" class="form-label">Email address <span>*</span></label>
                            <input
                                type="email"
                                class="form-control"
                                name="email"
                                id="email"
                                placeholder="you@example.com"
                                autocomplete="email"
                                required
                                oninput="validateEmail()">
                            <span id="emailError" class="field-error"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="phone" class="form-label">Phone number <span>*</span></label>
                            <input
                                type="tel"
                                class="form-control"
                                name="phone"
                                id="phone"
                                placeholder="10-digit mobile number"
                                autocomplete="tel"
                                inputmode="numeric"
                                maxlength="10"
                                required
                                oninput="validatePhone()">
                            <span id="phoneError" class="field-error"></span>
                        </div>

                        <div class="col-12">
                            <div class="message-label-row">
                                <label for="message" class="form-label">Your message <span>*</span></label>
                                <span id="messageCounter">0 / 400</span>
                            </div>
                            <textarea
                                class="form-control contact-textarea"
                                name="message"
                                id="message"
                                rows="5"
                                maxlength="400"
                                placeholder="Tell us how we can help you..."
                                required
                                oninput="validateMessage()"></textarea>
                            <span id="messageError" class="field-error"></span>
                        </div>
                    </div>

                    <div class="contact-form-footer">
                        <button type="button" class="contact-cancel-btn" onclick="goBack()">
                            Cancel
                        </button>
                        <button type="submit" id="submitButton" class="contact-submit-btn">
                            <span>Send message</span>
                            <i class="fa-regular fa-paper-plane"></i>
                        </button>
                    </div>
                </form>
            </div>

            <div class="contact-bottom-note">
                <i class="fa-regular fa-envelope"></i>
                <span>Prefer email? Reach us at</span>
                <a href="mailto:lapshopsite@gmail.com">lapshopsite@gmail.com</a>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/static/scripts/contact_form.js" defer></script>

<%- include("../userpartials/footer.ejs") %>
