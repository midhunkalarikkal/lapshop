<!-- Admin navbar -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LapShop</title>
    <link rel="icon" href="/static/images/Bg/desktop/Lapshoplogo.png" type="image/x-icon">

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

    <!--Bootstrap-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">

    <!--Font Awesome-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
        integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel='stylesheet' href='/static/css/nav_footer.css' type="text/css" />
    <link rel='stylesheet' href='/static/css/addoredit_address_checkout.css' type="text/css" />
</head>

<body>
 <nav class="navbar navbar-expand-lg navbar-dark py-2 fixed-top address-navbar">
        <div class="container address-container">
            <a href="/home" class="navbar-brand fw-bold fs-3">LapShop</a>
            <span class="address-nav-caption"><i class="fa-solid fa-lock me-2"></i>Secure checkout</span>
        </div>
    </nav>
    <main class="address-page">
        <div class="container address-container">
            <div class="address-page-header">
                <div>
                    <span class="address-eyebrow">CHECKOUT / EDIT ADDRESS</span>
                    <h1>Edit delivery address</h1>
                    <p>Update your saved delivery details before continuing to payment.</p>
                </div>
                <button type="button" class="address-back-btn" onclick="goBack()"><i class="fa-solid fa-arrow-left"></i> Back to checkout</button>
            </div>
            <div class="row g-4 align-items-start">
                <div class="col-lg-8">
                    <section class="address-form-panel">
                        <div class="address-panel-heading">
                            <span class="address-heading-icon"><i class="fa-solid fa-location-dot"></i></span>
                            <div>
                                <h2>Update delivery address</h2>
                                <p>Fields marked with * are required.</p>
                            </div>
                        </div>
                        <form>
                            <div class="address-form-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="name" class="form-label">Full name <span>*</span></label>
                                        <input type="text" class="form-control" name="name" id="name" value="<%= address.name %>" placeholder="Name of the recipient" autocomplete="name" required oninput="validateName()">
                                        <span id="nameError" class="address-field-error text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="phone" class="form-label">Phone number <span>*</span></label>
                                        <input type="tel" class="form-control" name="phone" id="phone" value="<%= address.phone %>" placeholder="10-digit mobile number" autocomplete="tel" inputmode="numeric" required oninput="validatePhone()">
                                        <span id="phoneError" class="address-field-error text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <label for="addressLine" class="form-label">Street address <span>*</span></label>
                                        <textarea class="form-control" name="addressLine" id="addressLine" rows="2" placeholder="House number, building, street or locality" autocomplete="street-address" required oninput="validateAddressLine()"><%= address.addressLine %></textarea>
                                        <span id="addressLineError" class="address-field-error text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="city" class="form-label">City / Town <span>*</span></label>
                                        <input type="text" class="form-control" name="city" id="city" value="<%= address.city %>" placeholder="Enter city or town" autocomplete="address-level2" required oninput="validateCity()">
                                        <span id="cityError" class="address-field-error text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="district" class="form-label">District <span>*</span></label>
                                        <input type="text" class="form-control" name="district" id="district" value="<%= address.district %>" placeholder="Enter district" required oninput="validateDistrict()">
                                        <span id="districtError" class="address-field-error text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="state" class="form-label">State <span>*</span></label>
                                        <input type="text" class="form-control" name="state" id="state" value="<%= address.state %>" placeholder="Enter state" autocomplete="address-level1" required oninput="validateState()">
                                        <span id="stateError" class="address-field-error text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="pincode" class="form-label">PIN code <span>*</span></label>
                                        <input type="text" class="form-control" name="pincode" id="pincode" value="<%= address.pincode %>" placeholder="6-digit PIN code" autocomplete="postal-code" inputmode="numeric" required oninput="validatePincode()">
                                        <span id="pincodeError" class="address-field-error text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <label for="country" class="form-label">Country <span>*</span></label>
                                        <div class="address-country-field">
                                            <input type="text" class="form-control" name="country" id="country" value="India" required readonly>
                                            <i class="fa-solid fa-lock"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" id="addressId" value="<%= address._id %>">
                            <div class="address-form-actions">
                                <button type="button" class="address-cancel-btn" onclick="goBack()">Cancel</button>
                                <button type="submit" id="submit" class="address-save-btn"><i class="fa-solid fa-check me-2"></i>Save changes</button>
                            </div>
                        </form>
                    </section>
                </div>
                <div class="col-lg-4">
                    <aside class="address-help-panel">
                        <div class="address-help-icon"><i class="fa-solid fa-truck-fast"></i></div>
                        <h2>Make delivery easy</h2>
                        <p>A complete address helps your order arrive without unnecessary delays.</p>
                        <div class="address-tip"><i class="fa-solid fa-circle-check"></i><span>Enter the recipient's full name and reachable mobile number.</span></div>
                        <div class="address-tip"><i class="fa-solid fa-circle-check"></i><span>Include your building, street, and locality in the address line.</span></div>
                        <div class="address-tip"><i class="fa-solid fa-circle-check"></i><span>Double-check your PIN code before saving.</span></div>
                        <div class="address-help-footer"><i class="fa-solid fa-shield-halved"></i> Your address is used to fulfill your order.</div>
                    </aside>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/static/scripts/user_updateAddress_checkout.js"></script>

    <!--Bootstrap-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous">
        </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
        integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
        crossorigin="anonymous" referrerpolicy="no-referrer">
        </script>

</body>
</html>