<%- include("../userpartials/navbar.ejs") %>
<head>
    <link rel="stylesheet" href="/static/css/wishlist.css" type="text/css">
</head>
<section class="view wishlist-page">
    <div class="container wishlist-container">
        <div class="wishlist-header">
            <div>
                <span class="wishlist-eyebrow">YOUR SAVED PICKS</span>
                <h1>Your Wishlist</h1>
                <p>Keep your favorite products in one place and move them to your cart when you're ready.</p>
            </div>
            <button type="button" class="btn wishlist-cart-link" onclick="gotoCart()">
                <i class="fas fa-shopping-cart" aria-hidden="true"></i>
                Go to cart
            </button>
        </div>
        <div class="row wishlist-layout g-4">
            <div class="col-12 col-lg-8">
                <div class="wishlist-panel">
                    <div class="wishlist-panel-header">
                        <h2>Saved products</h2>
                        <span class="wishlist-count"><%= products.length %> <%= products.length === 1 ? 'item' : 'items' %></span>
                    </div>
                    <% if (products.length > 0) { %>
                        <div class="wishlist-items">
                            <% products.forEach((product) => { %>
                                <article class="wishlist-item">
                                    <a class="wishlist-image" href="/productDetail/<%= product._id %>" aria-label="View <%= product.name %>">
                                        <img src="/static/images/ProductImages/<%= product.images[0] %>" alt="<%= product.name %>" loading="lazy">
                                    </a>
                                    <div class="wishlist-item-content">
                                        <div class="wishlist-item-top">
                                            <div class="wishlist-item-details">
                                                <span class="product-brand"><%= product.brand.name %></span>
                                                <a class="product-name" href="/productDetail/<%= product._id %>"><%= product.name %></a>
                                            </div>
                                            <% if (product.noOfStock === 0) { %>
                                                <span class="wishlist-stock out-of-stock">Out of stock</span>
                                            <% } else if (product.noOfStock < 5) { %>
                                                <span class="wishlist-stock low-stock">Only <%= product.noOfStock %> left</span>
                                            <% } else { %>
                                                <span class="wishlist-stock in-stock">In stock</span>
                                            <% } %>
                                        </div>
                                        <% for (let i = 0; i < wishlistProducts.length; i++) { %>
                                            <% if (product._id.toString() === wishlistProducts[i].product.toString()) { %>
                                                <p class="wishlist-added">Saved on <span class="item-added-date"><%= wishlistProducts[i].addedAt.toDateString() %></span></p>
                                            <% } %>
                                        <% } %>
                                        <div class="wishlist-actions">
                                            <button type="button" class="btn add-to-cart-btn" data-prod-id="<%= product._id %>" onclick="addToCart(this)" <% if (product.noOfStock === 0) { %>disabled<% } %>>
                                                <i class="fas fa-shopping-bag" aria-hidden="true"></i> Add to cart
                                            </button>
                                            <button type="button" class="btn delete-btn" data-prod-id="<%= product._id %>" onclick="deleteProduct(this)">
                                                <i class="fas fa-trash-alt" aria-hidden="true"></i> Remove
                                            </button>
                                        </div>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="wishlist-empty">
                            <div class="wishlist-empty-icon"><i class="far fa-heart" aria-hidden="true"></i></div>
                            <h3>Your wishlist is empty</h3>
                            <p>Explore our collection and save the products you love.</p>
                            <button type="button" class="btn wishlist-primary" onclick="goToShop()">Continue shopping</button>
                        </div>
                    <% } %>
                </div>
            </div>
            <aside class="col-12 col-lg-4">
                <div class="wishlist-summary">
                    <div class="wishlist-summary-heading">
                        <span class="wishlist-summary-icon"><i class="far fa-heart" aria-hidden="true"></i></span>
                        <h2>Wishlist summary</h2>
                    </div>
                    <div class="wishlist-summary-row">
                        <span>Total saved products</span>
                        <strong><%= products.length %></strong>
                    </div>
                    <div class="wishlist-summary-row">
                        <span>Available products</span>
                        <strong><%= products.filter(product => product.noOfStock > 0).length %></strong>
                    </div>
                    <div class="wishlist-summary-row">
                        <span>Out of stock</span>
                        <strong><%= products.filter(product => product.noOfStock === 0).length %></strong>
                    </div>
                    <div class="wishlist-summary-total">
                        <span>Total items</span>
                        <strong><%= products.length %></strong>
                    </div>
                    <button type="button" class="btn wishlist-primary w-100" onclick="gotoCart()">View shopping cart <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
                    <button type="button" class="btn wishlist-outline w-100" onclick="goToShop()">Continue shopping</button>
                    <p class="wishlist-summary-note">Items in your wishlist are not reserved. Availability may change.</p>
                </div>
            </aside>
        </div>
    </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
        ////// Function to delete a product from wishlist \\\\\\\\\\\\
        function deleteProduct(delbtn) {
            const productId = delbtn.getAttribute("data-prod-id");
            fetch('/deleteProductFromWishlist', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ productId: productId })
            })
            .then(response => {
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                    return response.json(); 
                } else {
                    window.location.href = `/login`;
                }
            })
            .then(data => {
                Swal.fire({
                    title: "Success",
                    text: data.message,
                    icon: "success",
                    timer: 2000,
                    background: "#333",
                    color: "#ffffff",
                    timerProgressBar: true,
                    showConfirmButton: false
                }).then(() => {
                    location.reload();
                });
            })
            .catch(error => {
                Swal.fire({
                    title: "Error",
                    text: error.message,
                    icon: "error",
                    timer: 2000,
                    background: "#333",
                    color: "#ffffff",
                    timerProgressBar: true,
                    showConfirmButton: false
                });
            });
        }
        ////// Function to redirect to cart page \\\\\\\\\\\\
        function gotoCart() {
            window.location.href = "/cart"
        }
        ////// Funciton to add wishlist product to cart \\\\\\\\\\\\
        function addToCart(element) {
            const productId = element.getAttribute('data-prod-id');
            fetch('/addProductToCartFromWishlist', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ productId: productId })
            })
            .then(response => {
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                    return response.json(); 
                } else {
                    window.location.href = `/login`;
                }
            })
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        title: "Success",
                        text: data.message,
                        icon: "success",
                        timer: 2000,
                        background: "#333",
                        color: "#ffffff",
                        timerProgressBar: true,
                        showConfirmButton: false
                    }).then(data =>{
                        location.reload()
                    })
                } else if(data.status === 409) {
                    Swal.fire({
                        title: "Info",
                        text: data.message,
                        icon: "info",
                        timer: 2000,
                        background: "#333",
                        color: "#ffffff",
                        timerProgressBar: true,
                        showConfirmButton: false
                    })
                } else {
                    Swal.fire({
                        title: "Error",
                        text: data.message,
                        icon: "error",
                        timer: 2000,
                        background: "#333",
                        color: "#ffffff",
                        timerProgressBar: true,
                        showConfirmButton: false
                    });
                }
            })
            .catch(error => {
                Swal.fire({
                    title: "Error",
                    text: "Internal server error.",
                    icon: "error",
                    timer: 2000,
                    background: "#333",
                    color: "#ffffff",
                    timerProgressBar: true,
                    showConfirmButton: false
                });
            });
        }
        ////// Function to go to shop \\\\\\\\\\\\
        function goToShop(){
            window.location.href ='/shop'
        }
    </script>
<%- include("../userpartials/footer.ejs") %>
