<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/static/images/Bg/desktop/Lapshoplogo.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/static/css/auth.css" type="text/css">
    <title>Forgot Password | LapShop</title>
</head>
<body>
<section class="view login-page auth-page forgot-page">
<div class="container login-container">
<div class="row g-0 login-layout">
<div class="col-lg-6 login-showcase">
    <div class="login-showcase-content">
        <span class="login-eyebrow"><i class="fa-solid fa-bolt me-2"></i>WELCOME TO LAPSHOP</span>
        <h1 class="left-text-one">Your tech journey, <span class="text-pr">made simple.</span></h1>
        <p class="left-text-two">Discover your next laptop with confidence.</p>
        <p class="left-text-three">Shop your favorites, track every order, and keep your account protected.</p>
        <div class="login-showcase-points">
            <div><i class="fa-solid fa-circle-check"></i> Carefully selected laptops</div>
            <div><i class="fa-solid fa-circle-check"></i> Simple, secure shopping</div>
            <div><i class="fa-solid fa-circle-check"></i> Orders in one place</div>
        </div>
    </div>
    <div class="login-showcase-footer"><i class="fa-solid fa-shield-halved me-2"></i>Shopping made simple and secure</div>
</div>
<div class="col-12 col-lg-6 login-form-side">
<div class="form-box" id="form-box-one">
    <div class="login-mobile-brand">Lap<span>Shop</span></div>
    <span class="login-form-eyebrow">ACCOUNT RECOVERY</span>
    <header class="title">Forgot your password?</header>
    <p class="login-subtitle">Verify your email to securely reset your password.</p>
    <form action="/login" method="post">
        <div class="input-field" id="email-input">
            <label for="email">Email address</label>
            <div class="login-input-wrap"><i class="fa-regular fa-envelope"></i><input type="text" class="input" id="email" name="email" placeholder="Enter your email" autocomplete="email" required oninput="validateEmail()"></div>
            <span id="emailError" class="input-error" aria-live="polite"></span>
        </div>
        <div class="input-field d-none" id="otp-input">
            <label for="otp">Verification code</label>
            <div class="login-input-wrap"><i class="fa-solid fa-key"></i><input type="text" class="input" id="otp" name="otp" placeholder="Enter your OTP" autocomplete="one-time-code" required></div>
        </div>
        <button type="button" class="btn auth-action" id="submit">Get OTP <i class="fa-solid fa-arrow-right ms-2"></i></button>
        <button type="button" class="btn auth-action" id="fpOtpVerify" style="display: none;">Verify code</button>
    </form>
    <div class="auth-timer signin"><span id="timer"></span></div>
    <div class="signin"><a href="/login"><i class="fa-solid fa-arrow-left me-2"></i>Back to sign in</a></div>
</div>
<div class="form-box" id="form-box-two" style="display: none;">
    <div class="login-mobile-brand">Lap<span>Shop</span></div>
    <span class="login-form-eyebrow">NEW PASSWORD</span>
    <header class="title">Reset password</header>
    <p class="login-subtitle">Choose a new password for your account.</p>
    <form action="/login" method="post">
        <div class="input-field"><label for="newPass">New password</label><div class="login-input-wrap"><i class="fa-solid fa-lock"></i><input type="password" class="input" id="newPass" name="newPass" placeholder="New password" autocomplete="new-password" required></div><span id="passwordError" class="input-error"></span></div>
        <div class="input-field"><label for="confirmPass">Confirm password</label><div class="login-input-wrap"><i class="fa-solid fa-lock"></i><input type="password" class="input" id="confirmPass" name="confirmPass" placeholder="Re-enter password" autocomplete="new-password" required></div><span id="confirmPasswordError" class="input-error"></span></div>
        <div class="login-form-options"><label class="login-show-password" for="showPasswordCheckbox"><input type="checkbox" id="showPasswordCheckbox" onchange="showpassword()"><span class="showpassword">Show password</span></label></div>
        <button type="button" class="btn auth-action" id="submitPassword" disabled>Save password</button>
    </form>
</div>
</div></div></div></section>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/static/scripts/user_forgotPassword.js"></script>
</body>
</html>
