<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LapShop</title>
    <link rel="icon" href="/static/images/Bg/desktop/Lapshoplogo.png" type="image/x-icon">

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

    <!--Bootstrap-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">

    <!--Font Awesome-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
        integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel='stylesheet' href='/static/css/nav_footer.css' type="text/css" />
    <link rel='stylesheet' href='/static/css/payment.css' type="text/css" />

</head>

<body>
   <nav class="navbar navbar-expand-lg navbar-dark py-2 fixed-top payment-navbar">
        <div class="container payment-container d-flex justify-content-between align-items-center">
            <a href="/home" class="navbar-brand fw-bold fs-3">LapShop</a>
            <span class="payment-nav-caption"><i class="fa-solid fa-lock me-2"></i>Secure checkout</span>
        </div>
    </nav>
    <main class="payment-page">
        <div class="container payment-container">
            <header class="payment-page-header">
                <div>
                    <span class="payment-eyebrow">FINAL CHECKOUT STEP</span>
                    <h1>Review &amp; payment</h1>
                    <p>Confirm your delivery details, apply a coupon and choose how to pay.</p>
                </div>
                <button type="button" class="payment-header-btn" onclick="history.back()"><i class="fa-solid fa-arrow-left"></i> Back to checkout</button>
            </header>
            <div class="row g-4 payment-main">
                <div class="col-lg-8">
                    <section class="payment-panel">
                        <div class="payment-panel-heading">
                            <span class="payment-heading-icon"><i class="fa-solid fa-bag-shopping"></i></span>
                            <div><h2>Order items</h2><p>Review the products in your order</p></div>
                        </div>
                        <div class="payment-items">
                            <% userCart.items.forEach((item, index) => { %>
                                <div class="payment-item">
                                    <span class="payment-item-number"><%= index + 1 %></span>
                                    <div class="payment-item-info">
                                        <strong><%= item.product.brand.name %> <%= item.product.name %></strong>
                                        <span>Quantity: <%= item.quantity %></span>
                                    </div>
                                    <strong class="payment-item-price">₹<%= Number(item.totalPrice).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
                                </div>
                            <% }) %>
                        </div>
                    </section>
                    <section class="payment-panel payment-section-gap">
                        <div class="payment-panel-heading">
                            <span class="payment-heading-icon"><i class="fa-solid fa-location-dot"></i></span>
                            <div><h2>Delivery address</h2><p>Where your order will be delivered</p></div>
                        </div>
                        <div class="payment-address">
                            <% if (userAddress && userAddress.length > 0) { %>
                                <strong><%= userAddress[0].name %></strong>
                                <p><%= userAddress[0].addressLine %>, <%= userAddress[0].city %>, <%= userAddress[0].district %>, <%= userAddress[0].state %> - <%= userAddress[0].pincode %>, <%= userAddress[0].country %></p>
                                <span><i class="fa-solid fa-phone"></i> <%= userAddress[0].phone %></span>
                                <input type="hidden" id="userAddress" value="<%= userAddress[0]._id %>">
                            <% } else { %>
                                <p class="mb-0">No delivery address is selected.</p>
                            <% } %>
                        </div>
                    </section>
                    <% if (coupon && coupon.length > 0) { %>
                        <section class="payment-panel payment-section-gap">
                            <div class="payment-panel-heading">
                                <span class="payment-heading-icon"><i class="fa-solid fa-ticket"></i></span>
                                <div><h2>Have a coupon?</h2><p>Apply an eligible promotional code to your order</p></div>
                            </div>
                            <div class="payment-coupon-content">
                                <% if (!userCart.couponApplied) { %>
                                    <div class="coupon" id="coupon">
                                        <div class="coupon-body" id="coupon-body">
                                            <input type="text" class="form-control" placeholder="Enter coupon code" id="userCouponCode" aria-label="Coupon code">
                                            <button type="button" class="payment-apply-btn" onclick="submitCoupon()">Apply code</button>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <div class="coupon-applied" id="coupon-applied">
                                        <div><i class="fa-solid fa-circle-check"></i> Coupon applied successfully</div>
                                        <button type="button" class="cancel-coupon" onclick="cancelCoupon()">Remove coupon</button>
                                        <input type="hidden" id="cancelCouponId" value="<%= userCart.couponCode %>">
                                    </div>
                                <% } %>
                            </div>
                        </section>
                    <% } %>
                    <section class="payment-panel payment-section-gap payment-help-panel">
                        <div class="payment-panel-heading">
                            <span class="payment-heading-icon"><i class="fa-solid fa-circle-question"></i></span>
                            <div><h2>Payment help</h2><p>Useful information before you place your order</p></div>
                        </div>
                        <div class="payment-help-content">
                            <div class="instructions">
                                <h3>Before you confirm</h3>
                                <p>Choose your payment method, review the final amount and verify your delivery address.</p>
                                <p>For eligible cancellations and returns, refunds are credited to your LapShop wallet under the current policy.</p>
                            </div>
                            <div class="accordion" id="paymentFAQs">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="faq1"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="true" aria-controls="collapse1">How can I apply a coupon?</button></h2>
                                    <div id="collapse1" class="accordion-collapse collapse show" aria-labelledby="faq1" data-bs-parent="#paymentFAQs"><div class="accordion-body">Copy an available coupon code from the home page, enter it above and select Apply code. The discount is applied if the coupon is eligible.</div></div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="faq2"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">Why is cash on delivery unavailable?</button></h2>
                                    <div id="collapse2" class="accordion-collapse collapse" aria-labelledby="faq2" data-bs-parent="#paymentFAQs"><div class="accordion-body">Cash on delivery is available only for orders below ₹1,000, subject to checkout eligibility.</div></div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="faq3"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">Can I combine my wallet with online payment?</button></h2>
                                    <div id="collapse3" class="accordion-collapse collapse" aria-labelledby="faq3" data-bs-parent="#paymentFAQs"><div class="accordion-body">If your wallet balance does not cover the full order amount, you may be able to pay the remainder online.</div></div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="faq4"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse4" aria-expanded="false" aria-controls="collapse4">What if my payment fails?</button></h2>
                                    <div id="collapse4" class="accordion-collapse collapse" aria-labelledby="faq4" data-bs-parent="#paymentFAQs"><div class="accordion-body">A failed payment does not release the order for shipment. Check your orders page for the payment status and any available retry option.</div></div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <aside class="col-lg-4">
                    <section class="payment-panel payment-summary">
                        <div class="payment-panel-heading">
                            <span class="payment-heading-icon"><i class="fa-solid fa-credit-card"></i></span>
                            <div><h2>Payment method</h2><p>Choose how you want to pay</p></div>
                        </div>
                        <div class="checkbox-payment">
                            <label class="payment-method" for="razorpay"><input type="radio" name="paymentMethod" id="razorpay"><span class="payment-method-icon"><i class="fa-solid fa-credit-card"></i></span><span><strong>Pay online</strong><small>Razorpay secure payment</small></span><i class="fa-solid fa-chevron-right payment-method-arrow"></i></label>
                            <label class="payment-method" for="cod"><input type="radio" name="paymentMethod" id="cod"><span class="payment-method-icon"><i class="fa-solid fa-truck"></i></span><span><strong>Cash on delivery</strong><small>Pay when your order arrives</small></span><i class="fa-solid fa-chevron-right payment-method-arrow"></i></label>
                            <label class="payment-method" for="wallet"><input type="radio" name="paymentMethod" id="wallet"><span class="payment-method-icon"><i class="fa-solid fa-wallet"></i></span><span><strong>LapShop wallet</strong><small>Use your available balance</small></span><i class="fa-solid fa-chevron-right payment-method-arrow"></i></label>
                        </div>
                        <% if (userCart) { %>
                            <div class="payment-summary-calculation">
                                <div class="payment-summary-line"><span>Original price</span><strong>₹<%= (userCart.totalCartPrice + userCart.totalCartDiscountPrice + userCart.couponAmount).toFixed(2) %></strong></div>
                                <div class="payment-summary-line"><span>Product discount</span><strong class="payment-discount">− ₹<%= userCart.totalCartDiscountPrice.toFixed(2) %></strong></div>
                                <% if (userCart.couponApplied) { %><div class="payment-summary-line"><span>Coupon discount</span><strong class="payment-discount">− ₹<%= userCart.couponAmount.toFixed(2) %></strong></div><% } %>
                                <div class="payment-summary-line"><span>Delivery</span><strong class="payment-discount">FREE</strong></div>
                                <div class="payment-summary-line payment-summary-total"><span>Total payable</span><strong>₹<span id="subTotal"><%= userCart.totalCartPrice.toFixed(2) %></span></strong></div>
                            </div>
                        <% } %>
                        <button type="button" onclick="confirmOrder()" class="payment-confirm-btn" id="goToPayment"><i class="fa-solid fa-lock"></i> Confirm order</button>
                        <p class="payment-secure-note"><i class="fa-solid fa-shield-halved"></i> Secure checkout</p>
                    </section>
                </aside>
            </div>
        </div>
    </main>
    <% if (userCart) { %>
        <div class="payment-mobile-bar">
            <div class="payment-mobile-total"><span>Total payable</span><strong>₹<%= userCart.totalCartPrice.toFixed(2) %></strong></div>
            <button type="button" onclick="confirmOrder()" class="payment-confirm-btn"><i class="fa-solid fa-lock"></i> Confirm order</button>
        </div>
    <% } %>

    <!-- script for sweet alert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- script for razorpay -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="/static/scripts/user_payment.js"></script>

    <!--Bootstrap-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
        integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
        crossorigin="anonymous" referrerpolicy="no-referrer">
    </script>

</body>

</html>