<%- include("../userpartials/navbar.ejs") %>

<head>
    <link rel="stylesheet" href="/static/css/addoredit_address.css" type="text/css">
</head>

<body>
    <section class="view address-edit-page">
        <div class="container d-flex align-items-center justify-content-center">
            <div class="main col-12 col-lg-10 my-4 my-md-5 bg-white">
                <form>
                    <div class="address-form-content">
                        <div class="address-form-heading">
                            <span class="address-form-eyebrow">ACCOUNT SETTINGS</span>
                            <h4 class="fs-3 mb-2">Edit address</h4>
                            <p class="address-form-subtitle mb-0">Keep your delivery information accurate and up to date.</p>
                        </div>

                        <% if (userAddress != "") { %>
                            <div class="input-box row g-4">
                                <div class="col-12 col-md-6">
                                    <div class="mb-4">
                                        <label for="name" class="form-label">Name</label>
                                        <input type="text" class="form-control" name="name" id="name" value="<%= userAddress.name %>" required oninput="validateName()" autocomplete="name">
                                        <span id="nameError" class="text-danger field-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label for="addressLine" class="form-label">Address line</label>
                                        <textarea class="form-control" name="addressLine" id="addressLine" rows="3" required oninput="validateAddressLine()"><%= userAddress.addressLine %></textarea>
                                        <span id="addressLineError" class="text-danger field-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label for="phone" class="form-label">Phone</label>
                                        <input type="text" class="form-control" name="phone" id="phone" value="<%= userAddress.phone %>" required oninput="validatePhone()" autocomplete="tel" inputmode="tel">
                                        <span id="phoneError" class="text-danger field-error"></span>
                                    </div>
                                    <div class="mb-4 mb-md-0">
                                        <label for="city" class="form-label">City</label>
                                        <input type="text" class="form-control" name="city" id="city" value="<%= userAddress.city %>" required oninput="validateCity()" autocomplete="address-level2">
                                        <span id="cityError" class="text-danger field-error"></span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="mb-4">
                                        <label for="district" class="form-label">District</label>
                                        <input type="text" class="form-control" name="district" id="district" value="<%= userAddress.district %>" required oninput="validateDistrict()">
                                        <span id="districtError" class="text-danger field-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label for="state" class="form-label">State</label>
                                        <input type="text" class="form-control" name="state" id="state" value="<%= userAddress.state %>" required oninput="validateState()" autocomplete="address-level1">
                                        <span id="stateError" class="text-danger field-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label for="pincode" class="form-label">Pincode</label>
                                        <input type="text" class="form-control" name="pincode" id="pincode" value="<%= userAddress.pincode %>" required oninput="validatePincode()" autocomplete="postal-code" inputmode="numeric">
                                        <span id="pincodeError" class="text-danger field-error"></span>
                                    </div>
                                    <div class="mb-4 mb-md-0">
                                        <label for="country" class="form-label">Country</label>
                                        <input type="text" class="form-control" name="country" id="country" value="<%= userAddress.country %>" required readonly autocomplete="country-name">
                                    </div>
                                </div>
                                <input type="hidden" value="<%= userAddress._id %>" id="addressId">
                            </div>
                            <div class="address-form-actions d-flex flex-wrap gap-3 mt-4">
                                <button type="button" class="btn btn-secondary" onclick="goBack()">Cancel</button>
                                <button type="submit" id="submit" class="btn btn-success">Save changes</button>
                            </div>
                        <% } %>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/static/scripts/user_updateAddress.js"></script>

    <%- include("../userpartials/footer.ejs") %>
