<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/static/images/Bg/desktop/Lapshoplogo.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/static/css/auth.css" type="text/css">
    <title>Sign In | LapShop</title>
</head>
<body>
<section class="view login-page">
    <div class="container login-container">
        <div class="row g-0 login-layout">
            <div class="col-lg-6 login-showcase">
                <div class="login-showcase-content">
                    <span class="login-eyebrow"><i class="fa-solid fa-bolt me-2"></i>WELCOME TO LAPSHOP</span>
                    <h1 class="left-text-one">Your next upgrade starts <span class="text-pr">here.</span></h1>
                    <p class="left-text-two">Empowering your <span class="text-pr">tech journey</span>, one click at a time.</p>
                    <p class="left-text-three">Discover laptops built for the way you work, create and play. Sign in to pick up right where you left off.</p>
                    <div class="login-showcase-points">
                        <div><i class="fa-solid fa-circle-check"></i> Explore your favorite laptops</div>
                        <div><i class="fa-solid fa-circle-check"></i> Manage orders and deliveries</div>
                        <div><i class="fa-solid fa-circle-check"></i> Enjoy a seamless shopping experience</div>
                    </div>
                </div>
                <div class="login-showcase-footer"><i class="fa-solid fa-shield-halved me-2"></i>Shopping made simple and secure</div>
            </div>

            <div class="col-12 col-lg-6 login-form-side">
                <div class="form-box">
                    <div class="login-mobile-brand">Lap<span>Shop</span></div>
                    <span class="login-form-eyebrow">YOUR ACCOUNT</span>
                    <header class="title">Welcome back</header>
                    <p class="login-subtitle">Sign in to continue your LapShop experience.</p>

                    <% if (message) { %>
                        <div class="alert alert-<%= type %> alert-dismissible fade show login-alert" role="alert" id="myAlert">
                            <strong><%= message %></strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>

                    <form id="loginForm">
                        <div class="input-field" id="email-input">
                            <label for="email">Email address</label>
                            <div class="login-input-wrap">
                                <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                                <input type="email" class="input" id="email" name="email" placeholder="Enter your email" autocomplete="email" required oninput="validateEmail()">
                            </div>
                            <span id="emailError" class="input-error" aria-live="polite"></span>
                        </div>

                        <div class="input-field">
                            <label for="password">Password</label>
                            <div class="login-input-wrap">
                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                <input type="password" class="input" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>
                            </div>
                        </div>

                        <div class="login-form-options">
                            <label class="login-show-password" for="showPasswordCheckbox">
                                <input type="checkbox" id="showPasswordCheckbox" onchange="showpassword()">
                                <span class="showpassword">Show password</span>
                            </label>
                            <a class="fp" href="/forgotPassword">Forgot password?</a>
                        </div>

                        <button type="submit" class="btn login-submit" id="submit">Sign in <i class="fa-solid fa-arrow-right"></i></button>

                        <div class="login-divider"><span>OR</span></div>

                        <div class="demo-login-box">
                            <div class="demo-login-header">
                                <span class="demo-badge">DEMO ACCESS</span>
                                <p>Just exploring? Try LapShop with a demo account.</p>
                            </div>
                            <button type="button" class="demo-login-btn" id="demoLoginBtn"><i class="fa-solid fa-user-astronaut me-2"></i>Use Demo Credentials</button>
                        </div>
                    </form>

                    <div class="signin">New to LapShop? <a href="/register">Create an account <i class="fa-solid fa-arrow-up-right-from-square"></i></a></div>
                    <p class="login-bottom-note"><i class="fa-solid fa-lock me-1"></i>Your account details stay private.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/static/scripts/user_login.js"></script>
</body>
</html>
