<%- include("../userpartials/navbar.ejs") %>
<link rel="stylesheet" href="/static/css/home.css">

<main class="view mt-4 wrapper home-page">
    <% if (homeCarousel && homeCarousel.length > 0) { %>
        <section class="home-hero">
            <div id="carouselExampleAutoplaying" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <% homeCarousel.forEach((hc, index) => { %>
                        <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                            <img src="/static/images/HomeCarousels/<%= hc.image %>" class="d-block w-100 homeCarousel-img" alt="<%= hc.tagline %>">
                            <div class="carousel-caption">
                                <div class="hero-content">
                                    <span class="hero-eyebrow">LAPSHOP COLLECTION</span>
                                    <div class="tagline"><h4><%= hc.tagline %></h4></div>
                                    <div class="desc-btn">
                                        <div class="desc"><h6><%= hc.desc %></h6></div>
                                        <button type="button" class="btn shop-btn" id="shop-btn">Shop now <i class="fa-solid fa-arrow-up-right-from-square"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev" aria-label="Previous slide">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next" aria-label="Next slide">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
                <div class="carousel-indicators">
                    <% homeCarousel.forEach((hc, index) => { %>
                        <button type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide-to="<%= index %>" class="<%= index === 0 ? 'active' : '' %>" <%= index === 0 ? 'aria-current="true"' : '' %> aria-label="Slide <%= index + 1 %>"></button>
                    <% }) %>
                </div>
            </div>
        </section>
    <% } %>

    <% if (category && category.length > 0) { %>
        <div class="caba">
            <section class="parallax-one home-section">
                <div class="container">
                    <div class="home-section-heading">
                        <div><span class="section-kicker">FIND YOUR FIT</span><h2>Shop by category</h2></div>
                        <a href="/shop" class="section-action">Explore all <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                    <div class="row g-3 g-lg-4">
                        <% category.forEach((cat, index) => { %>
                            <div class="col-6 col-lg-3">
                                <div class="card category-card">
                                    <div class="card-body" style="background-image: url('/static/images/CategoryImages/<%= cat.image %>');">
                                        <div class="category-content">
                                            <h3 class="card-title"><%= cat.name %></h3>
                                            <h6 class="card-text"><%= cat.desc %></h6>
                                        </div>
                                        <span class="category-arrow"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </section>
        </div>
    <% } %>

    <div class="bsac">
        <% if (bestSellingProducts && bestSellingProducts.length > 0) { %>
            <section class="home-section container" id="sectiontwo">
                <div class="home-section-heading">
                    <div><span class="section-kicker">CUSTOMER FAVORITES</span><h2>Best selling products</h2></div>
                    <a href="/shop" class="section-action">Shop all <i class="fa-solid fa-arrow-right"></i></a>
                </div>
                <div class="scroll-container">
                    <div class="home-products-track d-flex overflow-auto">
                        <% bestSellingProducts.forEach((product, index) => { %>
                            <a href="/productDetail/<%= product._id %>" class="product-outline">
                                <div class="box-two small-card">
                                    <div class="img"><img src="<%= product.imagePath %>" alt="<%= product.name %>" loading="lazy"></div>
                                    <div class="product-info">
                                        <h5 class="box-name"><%= product.name %></h5>
                                        <div class="box-price">
                                            <span class="product-discount"><%= product.discount %> off</span>
                                            <span class="product-price">₹<%= product.realPrice %></span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        <% }) %>
                    </div>
                </div>
            </section>
        <% } %>

        <% if (coupon && coupon.length > 0) { %>
            <section class="coupon-section home-section">
                <div class="container">
                    <div class="home-section-heading">
                        <div><span class="section-kicker">EXCLUSIVE SAVINGS</span><h2><%= coupon.length > 1 ? 'Available coupons' : 'Available coupon' %></h2></div>
                        <span class="section-caption">A little extra off, just for you.</span>
                    </div>
                    <div class="coupon-container">
                        <% for (let i = 0; i < coupon.length; i++) { %>
                            <div class="coupon">
                                <span class="coupon-label">SPECIAL OFFER</span>
                                <div class="coupon-title"><%= coupon[i].couponName %></div>
                                <div class="coupon-description">
                                    <% if (coupon[i].couponAmount <= 100) { %>
                                        Get <%= coupon[i].couponAmount %>% off on your purchase.
                                    <% } else { %>
                                        Get Rs. <%= coupon[i].couponAmount %> off on your purchase.
                                    <% } %>
                                </div>
                                <div class="coupon-code">
                                    <input type="text" value="<%= coupon[i].couponCode %>" class="text-center coupon-button" aria-label="Coupon code" readonly>
                                    <button type="button" class="couponcode">COPY</button>
                                </div>
                                <div class="coupon-description coupon-minimum">Minimum purchase amount Rs.<%= coupon[i].minAmount %></div>
                                <div class="coupon-expiry"><i class="fa-regular fa-clock"></i> Expires on: <%= coupon[i].endDate.toLocaleDateString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>
        <% } %>
    </div>

    <% if (brands && brands.length > 0) { %>
        <section class="home-section container home-brands" id="sectiontwo">
            <div class="home-section-heading centered"><span class="section-kicker">NAMES YOU KNOW</span><h2>Our trusted brands</h2></div>
            <div class="brands-grid">
                <% brands.forEach((brand, index) => { %>
                    <div class="image brand-box"><img src="/static/images/BrandImages/<%= brand.image %>" alt="Brand logo" class="img-fluid" loading="lazy"></div>
                <% }) %>
            </div>
        </section>
    <% } %>

    <section class="ourPromise home-section">
        <div class="container">
            <div class="home-section-heading centered">
                <span class="section-kicker">THE LAPSHOP EXPERIENCE</span>
                <h2>Our promises</h2>
                <p class="section-subtitle">Why we are your best choice for laptop needs</p>
            </div>
            <div class="row g-3 g-lg-4">
                <% const promises = [
                    ['fa-shipping-fast', 'Fast Delivery', 'We promise quick and reliable delivery of your orders.'],
                    ['fa-dollar-sign', 'Best Prices', 'We offer the most competitive prices on all our products.'],
                    ['fa-shield-alt', 'Secure Shopping', 'Your data is protected with our top-notch security measures.'],
                    ['fa-headset', '24/7 Support', 'We are here to assist you at any time, day or night.'],
                    ['fa-sync-alt', 'Easy Returns', 'Hassle-free returns and exchanges for your convenience.'],
                    ['fa-star', 'Quality Products', 'We guarantee high-quality products from top brands.']
                ]; %>
                <% promises.forEach((promise) => { %>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <div class="promise h-100">
                            <div class="icon"><i class="fas <%= promise[0] %>"></i></div>
                            <h4><%= promise[1] %></h4>
                            <p><%= promise[2] %></p>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/static/scripts/user_home.js"></script>
<%- include("../userpartials/footer.ejs") %>
