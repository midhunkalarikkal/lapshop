<%- include("../userpartials/navbar.ejs") %>
<head>
    <link rel="stylesheet" href="/static/css/order.css" type="text/css">
</head>
<section class="view orders-page">
    <div class="container orders-container">
        <div class="orders-header">
            <div>
                <span class="orders-eyebrow">YOUR PURCHASES</span>
                <h1>Your Orders</h1>
                <p>Review your purchases, track deliveries, and manage your orders in one place.</p>
            </div>
            <button type="button" class="btn orders-shop-link" onclick="goToShop()">
                <i class="fas fa-shopping-bag" aria-hidden="true"></i> Continue shopping
            </button>
        </div>
        <div class="orders-panel">
            <div class="orders-panel-header">
                <div>
                    <h2>Order history</h2>
                    <p>All your orders and their latest status</p>
                </div>
                <span class="orders-count"><%= order.length %> <%= order.length === 1 ? 'order' : 'orders' %></span>
            </div>
            <% if (order.length > 0) { %>
                <div class="orders-list">
                    <% for (let i = 0; i < order.length; i++) { %>
                        <article class="order-card">
                            <div class="order-card-heading">
                                <div class="order-card-meta">
                                    <span class="order-label">ORDER ID</span>
                                    <strong class="order-number"><%= order[i].orderId %></strong>
                                    <span class="order-date"><i class="far fa-calendar-alt" aria-hidden="true"></i> <%= order[i].orderDate.toLocaleDateString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                                </div>
                                <span class="order-status <%= order[i].status === 'Cancelled' || order[i].status === 'Admin cancelled' || order[i].status === 'Return rejected' ? 'order-status-danger' : order[i].status === 'Delivered' || order[i].status === 'Return accepted' ? 'order-status-success' : 'order-status-pending' %>"><%= order[i].status %></span>
                            </div>
                            <div class="order-card-body">
                                <div class="order-products">
                                    <% for (let j = 0; j < order[i].orderedItems.length; j++) { %>
                                        <div class="order-product">
                                            <a class="order-product-image" href="/productDetail/<%= order[i].orderedItems[j].product._id %>" aria-label="View <%= order[i].orderedItems[j].product.name %>">
                                                <img src="/static/images/ProductImages/<%= order[i].orderedItems[j].product.images[0] %>" alt="<%= order[i].orderedItems[j].product.name %>" loading="lazy">
                                            </a>
                                            <div class="order-product-info">
                                                <span class="order-product-brand"><%= order[i].orderedItems[j].product.brand.name %></span>
                                                <a class="order-product-name" href="/productDetail/<%= order[i].orderedItems[j].product._id %>"><%= order[i].orderedItems[j].product.name %></a>
                                                <span class="order-product-category"><%= order[i].orderedItems[j].product.category.name %></span>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="order-payment">
                                    <span class="order-label">ORDER TOTAL</span>
                                    <strong class="order-total">₹ <%= order[i].walletDebitedAmount && order[i].walletDeitedAmount !== 0 ? order[i].orderTotal + order[i].walletDebitedAmount : order[i].orderTotal %></strong>
                                    <% if (order[i].paymentStatus === false && order[i].status !== 'Cancelled' && order[i].paymentMethod !== 'cod') { %>
                                        <button type="button" class="btn order-pay-btn" id="repayment" onclick="repayment(this)" data-orderId="<%= order[i]._id %>">Complete payment</button>
                                    <% } %>
                                </div>
                            </div>
                            <div class="order-actions">
                                <button type="button" class="btn order-details-btn" id="prod-detail" onclick="goToOrderDetail(this)" data-orderId="<%= order[i]._id %>"><i class="fas fa-receipt" aria-hidden="true"></i> Details</button>
                                <% if (order[i].status === 'Cancelled' || order[i].status === 'Admin cancelled' || order[i].status === 'Return accepted' || order[i].status === 'Return rejected') { %>
                                    <button type="button" class="btn order-track-btn" onclick="goToTrackOrder(this)" data-orderId="<%= order[i]._id %>"><i class="fas fa-history" aria-hidden="true"></i> Order history</button>
                                <% } else { %>
                                    <button type="button" class="btn order-track-btn" onclick="goToTrackOrder(this)" data-orderId="<%= order[i]._id %>"><i class="fas fa-truck" aria-hidden="true"></i> Track order</button>
                                <% } %>
                                <% if (order[i].status === 'Delivered') { %>
                                    <button type="button" class="btn order-danger-btn" id="prod-cancel" onclick="returnOrder(this)" data-orderId="<%= order[i]._id %>">Return</button>
                                <% } else if (order[i].status === 'Processing' || order[i].status === 'Shipped') { %>
                                    <button type="button" class="btn order-danger-btn" id="prod-cancel" onclick="cancelOrder(this)" data-orderId="<%= order[i]._id %>">Cancel</button>
                                <% } %>
                            </div>
                        </article>
                    <% } %>
                </div>
            <% } else { %>
                <div class="orders-empty">
                    <span class="orders-empty-icon"><i class="fas fa-box-open" aria-hidden="true"></i></span>
                    <h3>No orders yet</h3>
                    <p>When you place an order, you can track its progress and view the details here.</p>
                    <button type="button" class="btn orders-primary" onclick="goToShop()">Continue shopping <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
                </div>
            <% } %>
        </div>
    </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/static/scripts/user_order.js"></script>
<%- include("../userpartials/footer.ejs") %>
