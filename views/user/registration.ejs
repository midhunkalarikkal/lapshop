<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/static/images/Bg/desktop/Lapshoplogo.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/static/css/auth.css" type="text/css">
    <title>Create Account | LapShop</title>
</head>
<body>
<section class="view login-page register-page">
    <div class="container login-container">
        <div class="row g-0 login-layout">
            <div class="col-lg-6 login-showcase">
                <div class="login-showcase-content">
                    <span class="login-eyebrow"><i class="fa-solid fa-bolt me-2"></i>JOIN LAPSHOP</span>
                    <h1 class="left-text-one">Find your next <span class="text-pr">big upgrade.</span></h1>
                    <p class="left-text-two">Your tech journey starts with the right choice.</p>
                    <p class="left-text-three">Create an account to explore laptops, save your favorites, and manage every order in one place.</p>
                    <div class="login-showcase-points">
                        <div><i class="fa-solid fa-circle-check"></i> Discover laptops for work and play</div>
                        <div><i class="fa-solid fa-circle-check"></i> Save favorites and shop with ease</div>
                        <div><i class="fa-solid fa-circle-check"></i> Track orders from your account</div>
                    </div>
                </div>
                <div class="login-showcase-footer"><i class="fa-solid fa-shield-halved me-2"></i>A simpler way to shop for technology</div>
            </div>

            <div class="col-12 col-lg-6 login-form-side">
                <div class="form-box">
                    <div class="login-mobile-brand">Lap<span>Shop</span></div>
                    <span class="login-form-eyebrow">CREATE YOUR ACCOUNT</span>
                    <header class="title">Join LapShop</header>
                    <p class="login-subtitle">A few details and you're ready to explore.</p>

                    <% if (message) { %>
                        <div class="alert alert-<%= type %> alert-dismissible fade show login-alert" role="alert" id="myAlert">
                            <strong><%= message %></strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>

                    <form action="/register" method="POST" id="registrationForm" onsubmit="return registerbtn()">
                        <div class="input-field" id="fullname-input">
                            <label for="fullname">Full name</label>
                            <div class="login-input-wrap">
                                <i class="fa-regular fa-user" aria-hidden="true"></i>
                                <input type="text" class="input" id="fullname" name="fullname" placeholder="First and last name" autocomplete="name" required oninput="validateFullName()">
                            </div>
                            <span id="fullnameError" class="input-error" aria-live="polite"></span>
                        </div>
                        <div class="input-field" id="email-input">
                            <label for="email">Email address</label>
                            <div class="login-input-wrap">
                                <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                                <input type="email" class="input" id="email" name="email" placeholder="Enter your email" autocomplete="email" required oninput="validateEmail()">
                            </div>
                            <span id="emailError" class="input-error" aria-live="polite"></span>
                        </div>
                        <div class="input-field" id="phone-input">
                            <label for="phone">Mobile number</label>
                            <div class="login-input-wrap">
                                <i class="fa-solid fa-phone" aria-hidden="true"></i>
                                <input type="text" class="input" id="phone" name="phone" placeholder="Enter your mobile number" autocomplete="tel" inputmode="tel" required oninput="validatePhone()">
                            </div>
                            <span id="phoneError" class="input-error" aria-live="polite"></span>
                        </div>
                        <div class="input-field" id="password-input">
                            <label for="password">Password</label>
                            <div class="login-input-wrap">
                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                <input type="password" class="input" id="password" name="password" placeholder="Create a password" autocomplete="new-password" required oninput="validatePassword()">
                            </div>
                            <span id="passwordError" class="input-error" aria-live="polite"></span>
                        </div>
                        <p class="passwordConditions" id="passwordConditions" style="display: none;">Use at least 8 characters, including an uppercase letter, lowercase letter, number, and special character (!@#$%^&amp;*).</p>
                        <div class="input-field" id="confirmPassword-input">
                            <label for="confirmpassword">Confirm password</label>
                            <div class="login-input-wrap">
                                <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                                <input type="password" class="input" id="confirmpassword" name="confirmpassword" placeholder="Re-enter your password" autocomplete="new-password" required oninput="validateConfirmPassword()">
                            </div>
                            <span id="confirmPasswordError" class="input-error" aria-live="polite"></span>
                        </div>
                        <div class="login-form-options register-options">
                            <label class="login-show-password" for="showPasswordCheckbox">
                                <input type="checkbox" id="showPasswordCheckbox" onchange="showpassword()">
                                <span class="showpassword">Show passwords</span>
                            </label>
                        </div>
                        <div class="referal register-referral">
                            <button type="button" class="register-referral-btn" onclick="showRefIn(event)"><i class="fa-solid fa-gift me-2"></i>Have a referral code? <i class="fa-solid fa-chevron-down ms-1"></i></button>
                            <input type="text" class="d-none register-referral-input" id="referal-input" name="referalCode" placeholder="Enter referral code">
                        </div>
                        <button type="submit" class="btn login-submit regiterbtn" id="submit">Create account <i class="fa-solid fa-arrow-right"></i></button>
                    </form>
                    <div class="signin">Already have an account? <a href="/login">Sign in <i class="fa-solid fa-arrow-up-right-from-square"></i></a></div>
                    <p class="login-bottom-note"><i class="fa-solid fa-lock me-1"></i>Your account details stay private.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/static/scripts/user_register.js"></script>
</body>
</html>
