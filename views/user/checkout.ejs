<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LapShop</title>
    <link rel="icon" href="/static/images/Bg/desktop/Lapshoplogo.png" type="image/x-icon">
    
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

    <!--Bootstrap-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">

    <!--Font Awesome-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
        integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel='stylesheet' href='/static/css/nav_footer.css' type="text/css" />
    <link rel='stylesheet' href='/static/css/checkout.css' type="text/css" />
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark py-2 fixed-top checkout-navbar">
        <div class="container checkout-nav-inner">
            <a href="/home" class="navbar-brand fw-bold fs-3 mb-0">LapShop</a>
            <span class="checkout-nav-title"><i class="fa-solid fa-lock me-2"></i>Secure checkout</span>
        </div>
    </nav>
    <main class="view checkout-page">
        <div class="container checkout-container">
            <header class="checkout-header">
                <div>
                    <span class="checkout-eyebrow">ALMOST THERE</span>
                    <h1>Checkout</h1>
                    <p>Select your delivery address and review your order before continuing to payment.</p>
                </div>
                <button type="button" class="btn checkout-header-btn" onclick="goToCart()"><i class="fa-solid fa-arrow-left"></i> Review cart</button>
            </header>
            <div class="row g-4 align-items-start checkout-main">
                <div class="col-lg-8">
                    <section class="checkout-panel address-panel">
                        <div class="checkout-panel-heading">
                            <div class="checkout-heading-icon"><i class="fa-solid fa-location-dot"></i></div>
                            <div class="checkout-panel-title"><span class="checkout-step-label">STEP 01</span><h2>Delivery address</h2><p>Choose where your order should be delivered.</p></div>
                            <span class="checkout-panel-tag"><i class="fa-solid fa-shield-halved"></i> Secure</span>
                        </div>
                        <% if (!userAddress || userAddress.length === 0) { %>
                            <div class="checkout-empty-address"><i class="fa-solid fa-map-location-dot"></i><h3>No addresses added yet</h3><p>Add a delivery address to continue with checkout.</p></div>
                        <% } else { %>
                            <div class="checkout-address-list">
                                <% userAddress.forEach((address, index) => { %>
                                    <div class="checkout-address-option">
                                        <input type="radio" name="selectedAddress" value="<%= address._id %>" id="address<%= address._id %>" class="checkout-address-radio" />
                                        <label class="checkout-address-label" for="address<%= address._id %>">
                                            <span class="checkout-radio-indicator"></span>
                                            <span class="checkout-address-content"><span class="checkout-address-top"><strong><%= address.name %></strong><span class="checkout-address-number">Address <%= index + 1 %></span></span><span class="checkout-address-line"><%= address.addressLine %>, <%= address.city %>, <%= address.district %></span><span class="checkout-address-line"><%= address.state %> - <%= address.pincode %>, <%= address.country %></span><span class="checkout-address-phone"><i class="fa-solid fa-phone"></i> <%= address.phone %></span></span>
                                        </label>
                                        <div class="checkout-address-actions"><button type="button" class="btn edit-address-btn" id="edit-address" data-adId="<%= address._id %>" aria-label="Edit address"><i class="fa-regular fa-pen-to-square"></i></button><button type="button" class="btn delete-address-btn" data-adid="<%= address._id %>" aria-label="Delete address"><i class="fa-regular fa-trash-can"></i></button></div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>
                        <div class="checkout-address-footer"><button type="button" class="btn checkout-add-btn" id="add-address"><i class="fa-solid fa-plus"></i> Add new address</button></div>
                    </section>
                    <section class="checkout-panel checkout-help-panel">
                        <div class="checkout-panel-heading"><div class="checkout-heading-icon"><i class="fa-regular fa-circle-question"></i></div><div class="checkout-panel-title"><span class="checkout-step-label">NEED HELP?</span><h2>Address help & FAQs</h2><p>Helpful information about managing your delivery address.</p></div></div>
                        <div class="checkout-help-note"><i class="fa-solid fa-circle-info"></i><p>Enter accurate address and phone details, then select the address you want to use for delivery. You can edit or remove saved addresses above.</p></div>
                        <div class="accordion" id="faqAccordion">
<h4 class="mx-3">FAQ's</h4>
<div class="accordion-item">
<h2 class="accordion-header" id="headingAddressNotAccepted">
<button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAddressNotAccepted" aria-expanded="true" aria-controls="collapseAddressNotAccepted">
Why is my address not being accepted?
</button>
</h2>
<div id="collapseAddressNotAccepted" class="accordion-collapse collapse show" aria-labelledby="headingAddressNotAccepted" data-bs-parent="#faqAccordion">
<div class="accordion-body">
Ensure that all fields are filled out correctly and match the required format. Double-check for any typos or missing information.
</div>
</div>
</div>
<div class="accordion-item">
<h2 class="accordion-header" id="headingAddressDoesNotFit">
<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAddressDoesNotFit" aria-expanded="false" aria-controls="collapseAddressDoesNotFit">
What should I do if my address does not fit into the provided fields?
</button>
</h2>
<div id="collapseAddressDoesNotFit" class="accordion-collapse collapse" aria-labelledby="headingAddressDoesNotFit" data-bs-parent="#faqAccordion">
<div class="accordion-body">
Use additional address lines or a notes field (if available) to include any extra details.
</div>
</div>
</div>
<div class="accordion-item">
<h2 class="accordion-header" id="headingAddressAccuracy">
<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAddressAccuracy" aria-expanded="false" aria-controls="collapseAddressAccuracy">
How can I ensure my address is accurate?
</button>
</h2>
<div id="collapseAddressAccuracy" class="accordion-collapse collapse" aria-labelledby="headingAddressAccuracy" data-bs-parent="#faqAccordion">
<div class="accordion-body">
Review your address carefully before submitting. Use tools like postal code lookups to verify accuracy.
</div>
</div>
</div>
<div class="accordion-item">
<h2 class="accordion-header" id="headingMistakeAfterSubmitting">
<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMistakeAfterSubmitting" aria-expanded="false" aria-controls="collapseMistakeAfterSubmitting">
What should I do if I made a mistake after submitting?
</button>
</h2>
<div id="collapseMistakeAfterSubmitting" class="accordion-collapse collapse" aria-labelledby="headingMistakeAfterSubmitting" data-bs-parent="#faqAccordion">
<div class="accordion-body">
Use the “Edit” option to correct your address details. Make sure to save the changes.
</div>
</div>
</div>
<div class="accordion-item">
<h2 class="accordion-header" id="headingPhoneNumberRequired">
<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePhoneNumberRequired" aria-expanded="false" aria-controls="collapsePhoneNumberRequired">
Why is my phone number required?
</button>
</h2>
<div id="collapsePhoneNumberRequired" class="accordion-collapse collapse" aria-labelledby="headingPhoneNumberRequired" data-bs-parent="#faqAccordion">
<div class="accordion-body">
A phone number is essential for delivery services to contact you regarding any issues or updates related to your order.
</div>
</div>
</div>
<div class="accordion-item">
<h2 class="accordion-header" id="headingChangeDefaultAddress">
<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseChangeDefaultAddress" aria-expanded="false" aria-controls="collapseChangeDefaultAddress">
How do I change my default address for delivery?
</button>
</h2>
<div id="collapseChangeDefaultAddress" class="accordion-collapse collapse" aria-labelledby="headingChangeDefaultAddress" data-bs-parent="#faqAccordion">
<div class="accordion-body">
Go to your address book and select the new address you want to set as default.
</div>
</div>
</div>
<div class="accordion-item">
<h2 class="accordion-header" id="headingCountryNotInDropdown">
<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCountryNotInDropdown" aria-expanded="false" aria-controls="collapseCountryNotInDropdown">
What if I don’t see my country in the dropdown list?
</button>
</h2>
<div id="collapseCountryNotInDropdown" class="accordion-collapse collapse" aria-labelledby="headingCountryNotInDropdown" data-bs-parent="#faqAccordion">
<div class="accordion-body">
Contact customer support for assistance. They may be able to add it or help you with alternative solutions.
</div>
</div>
</div>
<div class="accordion-item">
<h2 class="accordion-header" id="headingAddMultipleAddresses">
<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAddMultipleAddresses" aria-expanded="false" aria-controls="collapseAddMultipleAddresses">
Can I add multiple addresses?
</button>
</h2>
<div id="collapseAddMultipleAddresses" class="accordion-collapse collapse" aria-labelledby="headingAddMultipleAddresses" data-bs-parent="#faqAccordion">
<div class="accordion-body">
Yes, you can typically add and manage multiple addresses in your account settings.
</div>
</div>
</div>
<div class="accordion-item">
<h2 class="accordion-header" id="headingDeleteAddress">
<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDeleteAddress" aria-expanded="false" aria-controls="collapseDeleteAddress">
How do I delete an address?
</button>
</h2>
<div id="collapseDeleteAddress" class="accordion-collapse collapse" aria-labelledby="headingDeleteAddress" data-bs-parent="#faqAccordion">
<div class="accordion-body">
Use the “Delete” option next to the address you wish to remove. Ensure that at least one address remains for delivery purposes.
</div>
</div>
</div>
</div>
                    </section>
                </div>
                <aside class="col-lg-4">
                    <% if (userCart) { %>
                        <section class="checkout-panel checkout-summary">
                            <div class="checkout-summary-heading"><span class="checkout-step-label">YOUR PURCHASE</span><h2>Order summary</h2><p>Review the items in your cart.</p></div>
                            <div class="checkout-summary-items">
                                <% userCart.items.forEach((item, index) => { %>
                                    <div class="checkout-summary-item"><div class="checkout-summary-item-index"><%= index + 1 %></div><div class="checkout-summary-item-body"><strong><%= item.product.brand.name %> <%= item.product.name %></strong><span>Offer price</span></div><span class="checkout-summary-price">₹ <%= Number(item.product.offerPrice).toFixed(2) %></span></div>
                                <% }); %>
                            </div>
                            <div class="checkout-summary-calculation"><div class="checkout-summary-line"><span>Items</span><strong><%= userCart.items.length %></strong></div><div class="checkout-summary-line"><span>Delivery</span><strong class="checkout-free">FREE</strong></div><div class="checkout-summary-line checkout-summary-total"><span>Subtotal</span><strong>₹ <%= Number(userCart.totalCartPrice).toFixed(2) %></strong></div></div>
                            <div class="checkout-delivery-note"><i class="fa-solid fa-truck-fast"></i> Free delivery on your order</div>
                            <button type="button" class="btn checkout-payment-btn" onclick="goToPayment()" id="goToPayment">Proceed to payment <i class="fa-solid fa-arrow-right"></i></button>
                            <p class="checkout-safe-note"><i class="fa-solid fa-lock"></i> Secure checkout</p>
                        </section>
                    <% } %>
                    <div class="checkout-side-help"><i class="fa-solid fa-headset"></i><div><strong>Need to make changes?</strong><p>Review your cart or continue shopping before payment.</p><div class="checkout-side-links"><button type="button" onclick="goToCart()">Review cart</button><button type="button" onclick="goToShop()">Back to shop</button></div></div></div>
                </aside>
            </div>
        </div>
        <% if (userCart) { %>
            <div class="checkout-mobile-bar"><div class="checkout-mobile-total"><span>Subtotal</span><strong>₹ <%= Number(userCart.totalCartPrice).toFixed(2) %></strong></div><button type="button" class="btn checkout-payment-btn" onclick="goToPayment()" id="goToPayment">Proceed to payment <i class="fa-solid fa-arrow-right"></i></button></div>
        <% } %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/static/scripts/checkout.js"></script>

    <!--Bootstrap-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous">
        </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
        integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
        crossorigin="anonymous" referrerpolicy="no-referrer">
    </script>

</body>

</html>
