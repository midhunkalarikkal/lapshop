<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/static/images/Bg/desktop/Lapshoplogo.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/static/css/auth.css" type="text/css">
    <title>Verify OTP | LapShop</title>
</head>
<body>
<section class="view login-page auth-page otp-page">
<div class="container login-container">
<div class="row g-0 login-layout">
<div class="col-lg-6 login-showcase">
    <div class="login-showcase-content">
        <span class="login-eyebrow"><i class="fa-solid fa-bolt me-2"></i>WELCOME TO LAPSHOP</span>
        <h1 class="left-text-one">Your tech journey, <span class="text-pr">made simple.</span></h1>
        <p class="left-text-two">Discover your next laptop with confidence.</p>
        <p class="left-text-three">Shop your favorites, track every order, and keep your account protected.</p>
        <div class="login-showcase-points">
            <div><i class="fa-solid fa-circle-check"></i> Carefully selected laptops</div>
            <div><i class="fa-solid fa-circle-check"></i> Simple, secure shopping</div>
            <div><i class="fa-solid fa-circle-check"></i> Orders in one place</div>
        </div>
    </div>
    <div class="login-showcase-footer"><i class="fa-solid fa-shield-halved me-2"></i>Shopping made simple and secure</div>
</div>
<div class="col-12 col-lg-6 login-form-side">
<div class="form-box">
    <div class="login-mobile-brand">Lap<span>Shop</span></div>
    <span class="login-form-eyebrow">EMAIL VERIFICATION</span>
    <header class="title">Verify your email</header>
    <p class="login-subtitle">Enter the six-digit code sent to your email address.</p>
    <form>
        <div class="d-flex auth-otp-fields"><div class="input-field"><input type="text" class="input otp-input" id="otp" name="otp" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="OTP digit 1" required></div>
<div class="input-field"><input type="text" class="input otp-input" id="otp" name="otp2" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="OTP digit 2" required></div>
<div class="input-field"><input type="text" class="input otp-input" id="otp" name="otp3" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="OTP digit 3" required></div>
<div class="input-field"><input type="text" class="input otp-input" id="otp" name="otp4" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="OTP digit 4" required></div>
<div class="input-field"><input type="text" class="input otp-input" id="otp" name="otp5" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="OTP digit 5" required></div>
<div class="input-field"><input type="text" class="input otp-input" id="otp" name="otp6" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="OTP digit 6" required></div></div>
        <div class="input-field"><button class="btn auth-action" id="submit">Verify OTP <i class="fa-solid fa-arrow-right ms-2"></i></button></div>
    </form>
    <button class="btn auth-secondary-action" onclick="sendotp()" id="sendOtp">Click here to get OTP</button>
    <div class="signin auth-timer"><span id="otpTimeView"></span></div>
    <% if(message){ %><div class="alert alert-dismissible fade show alert-<%=type%>" role="alert" id="myAlert"><strong><%= message %></strong></div><% } %>
    <div class="signin"><a href="/login"><i class="fa-solid fa-arrow-left me-2"></i>Back to sign in</a></div>
</div>
</div></div></div></section>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/static/scripts/user_otpValidation.js"></script>
</body>
</html>
