<%- include("../userpartials/navbar.ejs") %>
<head>
    <link rel="stylesheet" href="/static/css/order_detail.css" type="text/css">
</head>
<section class="view order-detail-page">
    <div class="container order-detail-container">
        <div class="order-detail-header">
            <div>
                <span class="order-eyebrow">PURCHASE INFORMATION</span>
                <h1>Order details</h1>
                <p>Review your items, payment information and delivery details in one place.</p>
            </div>
            <a class="btn order-back-btn" href="/orders"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to orders</a>
        </div>
        <% if (order && order !== "" && order.length > 0) { %>
            <% for (let i = 0; i < order.length; i++) { %>
                <% const currentOrder = order[i]; %>
                <% const walletUsed = Number(currentOrder.walletDebitedAmount) || 0; %>
                <% const payableTotal = Number(currentOrder.orderTotal) || 0; %>
                <% const displayTotal = payableTotal + walletUsed; %>
                <% const deliveryEstimate = new Date(currentOrder.orderDate); deliveryEstimate.setDate(deliveryEstimate.getDate() + 4); %>
                <div class="order-overview order-surface">
                    <div class="order-overview-main">
                        <span class="order-label">ORDER NUMBER</span>
                        <h2>#<%= currentOrder.orderId %></h2>
                        <p>Placed on <%= currentOrder.orderDate.toLocaleDateString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></p>
                    </div>
                    <div class="order-overview-side">
                        <span class="order-status <%= ['Cancelled', 'Admin cancelled', 'Return rejected'].includes(currentOrder.status) ? 'status-negative' : currentOrder.status === 'Delivered' || currentOrder.status === 'Return accepted' ? 'status-positive' : 'status-progress' %>"><i class="fas fa-circle" aria-hidden="true"></i> <%= currentOrder.status %></span>
                        <span class="order-status-date">Updated <%= currentOrder.statusDate.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                    </div>
                </div>
                <div class="order-detail-layout row g-4">
                    <div class="col-12 col-lg-8">
                        <section class="order-surface order-items-panel">
                            <div class="order-section-heading">
                                <div><span class="order-section-eyebrow">YOUR PURCHASE</span><h3>Ordered items <span class="order-count"><%= currentOrder.orderedItems.length %></span></h3></div>
                                <i class="fas fa-box-open order-heading-icon" aria-hidden="true"></i>
                            </div>
                            <% for (let j = 0; j < currentOrder.orderedItems.length; j++) { %>
                                <% const item = currentOrder.orderedItems[j]; %>
                                <article class="order-product">
                                    <a class="order-product-image" href="/productDetail/<%= item.product._id %>"><img src="/static/images/ProductImages/<%= item.product.images[0] %>" alt="<%= item.product.name %>" loading="lazy"></a>
                                    <div class="order-product-content">
                                        <span class="order-product-brand"><%= item.product.brand.name %></span>
                                        <a class="order-product-name" href="/productDetail/<%= item.product._id %>"><%= item.product.name %></a>
                                        <p class="order-product-description"><%= item.product.description %></p>
                                        <div class="order-product-specs">
                                            <span><strong>Category:</strong> <%= item.product.category.name %></span>
                                            <span><strong>Colour:</strong> <%= item.product.colour %></span>
                                            <span><strong>RAM:</strong> <%= item.ramSize %></span>
                                            <span><strong>Weight:</strong> <%= item.weight %></span>
                                        </div>
                                        <div class="order-product-bottom"><span class="order-quantity">Qty: <strong><%= item.quantity %></strong></span><strong class="order-item-price">₹ <%= item.product.offerPrice %></strong></div>
                                    </div>
                                </article>
                            <% } %>
                        </section>
                        <div class="row g-4 order-info-row">
                            <div class="col-12 col-md-6">
                                <section class="order-surface order-info-card">
                                    <div class="order-info-title"><span class="order-info-icon"><i class="fas fa-credit-card" aria-hidden="true"></i></span><h3>Payment information</h3></div>
                                    <div class="order-info-field"><span>Payment method</span><strong><% if (currentOrder.paymentMethod === 'cod') { %>Cash on delivery<% } else if (currentOrder.paymentMethod === 'razorpay') { %>Razorpay<% } else if (currentOrder.paymentMethod === 'wallet') { %>Wallet<% } else if (currentOrder.paymentMethod === 'wallet with razorpay') { %>Wallet with Razorpay<% } else { %><%= currentOrder.paymentMethod %><% } %></strong></div>
                                    <div class="order-info-field"><span>Payment status</span><strong class="<%= currentOrder.paymentStatus ? 'payment-success' : 'payment-pending' %>"><%= currentOrder.paymentStatus ? 'Payment completed' : 'Payment not completed' %></strong></div>
                                    <% if (currentOrder.paymentStatus === false && currentOrder.paymentMethod !== 'cod' && !['Cancelled', 'Request return', 'Request rejected', 'Request accepted', 'Admin cancelled'].includes(currentOrder.status)) { %>
                                        <button type="button" class="btn order-pay-btn" id="repayment" onclick="repayment(this)" data-orderId="<%= currentOrder._id %>">Complete payment <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
                                    <% } %>
                                    <% if (currentOrder.paymentStatus !== false && ['Cancelled', 'Return accepted'].includes(currentOrder.status) && ['razorpay', 'wallet', 'wallet with razorpay'].includes(currentOrder.paymentMethod)) { %>
                                        <p class="order-refund-note"><i class="fas fa-check-circle" aria-hidden="true"></i> Order amount credited to your wallet</p>
                                    <% } %>
                                </section>
                            </div>
                            <div class="col-12 col-md-6">
                                <section class="order-surface order-info-card">
                                    <div class="order-info-title"><span class="order-info-icon"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><h3>Shipping & billing address</h3></div>
                                    <% if (currentOrder.address) { %>
                                        <address class="order-address"><strong><%= currentOrder.address.name %></strong><span><%= currentOrder.address.addressLine %></span><span><%= currentOrder.address.city %>, <%= currentOrder.address.district %></span><span><%= currentOrder.address.state %> - <%= currentOrder.address.pincode %></span><span><%= currentOrder.address.country %></span><span class="order-phone"><i class="fas fa-phone-alt" aria-hidden="true"></i> <%= currentOrder.address.phone %></span></address>
                                    <% } else { %><p class="order-address-missing">Address not found</p><% } %>
                                </section>
                            </div>
                        </div>
                    </div>
                    <aside class="col-12 col-lg-4">
                        <div class="order-summary order-surface">
                            <div class="order-info-title"><span class="order-info-icon"><i class="fas fa-receipt" aria-hidden="true"></i></span><h3>Order summary</h3></div>
                            <div class="order-summary-line"><span>Items</span><strong><%= currentOrder.orderedItems.length %></strong></div>
                            <div class="order-summary-line"><span>Delivery</span><strong class="payment-success">Free</strong></div>
                            <% if (currentOrder.couponApplied) { %><div class="order-summary-line"><span>Coupon</span><strong class="payment-success">Applied</strong></div><% } %>
                            <% if (walletUsed > 0) { %>
                                <div class="order-summary-line"><span>Online paid amount</span><strong>₹ <%= payableTotal %></strong></div>
                                <div class="order-summary-line"><span>Wallet used amount</span><strong>₹ <%= walletUsed %></strong></div>
                            <% } else { %>
                                <div class="order-summary-line"><span>Order amount</span><strong>₹ <%= payableTotal %></strong></div>
                            <% } %>
                            <div class="order-summary-total"><span>Order total</span><strong>₹ <%= displayTotal %></strong></div>
                            <div class="order-delivery-info"><i class="fas fa-truck" aria-hidden="true"></i><div><strong>Estimated delivery</strong><span><%= deliveryEstimate.toLocaleDateString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></span></div></div>
                            <% if (currentOrder.status === 'Delivered') { %>
                                <button type="button" class="btn order-invoice-btn" id="downloadInvoice" data-order-id="<%= currentOrder._id %>" onclick="downloadInvoice('<%= currentOrder._id %>')"><i class="fas fa-file-invoice" aria-hidden="true"></i> Generate invoice</button>
                            <% } %>
                        </div>
                    </aside>
                </div>
            <% } %>
        <% } else { %>
            <div class="order-surface order-empty"><i class="fas fa-box-open" aria-hidden="true"></i><h2>No order details found</h2><p>Explore the shop to discover products you may like.</p><a href="/shop" class="btn order-shop-btn">Continue shopping</a></div>
        <% } %>
    </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/static/scripts/user_orderDetail.js"></script>
<%- include("../userpartials/footer.ejs") %>
