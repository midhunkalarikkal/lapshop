<%- include("../userpartials/navbar.ejs") %>
<head>
    <link rel="stylesheet" href="/static/css/track_order.css" type="text/css">
</head>
<section class="view tracking-page">
    <div class="container tracking-container">
        <div class="tracking-header">
            <div>
                <span class="tracking-eyebrow">ORDER UPDATES</span>
                <h1>Track Your Order</h1>
                <p>Follow your order's journey and review every status update in one place.</p>
            </div>
            <a href="/orders" class="btn tracking-back-link">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                Back to orders
            </a>
        </div>
        <% const history = Array.isArray(order.trackArray) ? order.trackArray : []; %>
        <% const latest = history.length ? history[history.length - 1] : null; %>
        <% const normalizedStatus = String(order.status || '').toLowerCase(); %>
        <% const isCancelled = normalizedStatus.includes('cancel'); %>
        <% const isReturned = normalizedStatus.includes('return'); %>
        <div class="tracking-overview">
            <div class="tracking-overview-icon"><i class="fas fa-box-open" aria-hidden="true"></i></div>
            <div class="tracking-overview-copy">
                <span class="tracking-overview-kicker">CURRENT ORDER STATUS</span>
                <h2><%= order.status %></h2>
                <p>Order #<%= order.orderId %> <span class="tracking-dot">•</span> Placed <%= new Date(order.orderDate || order.createdAt).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
            </div>
            <span class="tracking-status <%= isCancelled ? 'tracking-status-danger' : isReturned ? 'tracking-status-warning' : 'tracking-status-success' %>"><span class="tracking-status-dot"></span><%= order.status %></span>
        </div>
        <div class="row g-4 tracking-layout">
            <div class="col-12 col-lg-8">
                <section class="tracking-panel" aria-labelledby="tracking-progress-heading">
                    <div class="tracking-panel-heading">
                        <div>
                            <span class="tracking-section-kicker">SHIPMENT JOURNEY</span>
                            <h2 id="tracking-progress-heading">Order progress</h2>
                        </div>
                        <span class="tracking-count"><%= history.length %> <%= history.length === 1 ? 'update' : 'updates' %></span>
                    </div>
                    <% if (history.length > 0) { %>
                        <ol class="tracking-timeline">
                            <% history.forEach((step, index) => { %>
                                <% const status = String(step.status || ''); %>
                                <% const statusLower = status.toLowerCase(); %>
                                <% const stepCancelled = statusLower.includes('cancel') || statusLower.includes('rejected'); %>
                                <% const stepReturn = statusLower.includes('return'); %>
                                <% const stepLatest = index === history.length - 1; %>
                                <li class="tracking-step <%= stepCancelled ? 'tracking-step-danger' : stepReturn ? 'tracking-step-return' : stepLatest ? 'tracking-step-current' : 'tracking-step-complete' %>">
                                    <div class="tracking-step-marker">
                                        <% if (stepCancelled) { %>
                                            <i class="fas fa-times" aria-hidden="true"></i>
                                        <% } else if (statusLower.includes('deliver')) { %>
                                            <i class="fas fa-check" aria-hidden="true"></i>
                                        <% } else if (statusLower.includes('ship')) { %>
                                            <i class="fas fa-truck" aria-hidden="true"></i>
                                        <% } else if (stepReturn) { %>
                                            <i class="fas fa-undo" aria-hidden="true"></i>
                                        <% } else if (statusLower.includes('process')) { %>
                                            <i class="fas fa-box" aria-hidden="true"></i>
                                        <% } else { %>
                                            <i class="fas fa-check" aria-hidden="true"></i>
                                        <% } %>
                                    </div>
                                    <div class="tracking-step-content">
                                        <div class="tracking-step-title-row">
                                            <h3><%= status %></h3>
                                            <% if (stepLatest) { %><span class="tracking-latest">Latest update</span><% } %>
                                        </div>
                                        <time class="tracking-step-date" datetime="<%= new Date(step.updatedAt).toISOString() %>">
                                            <i class="far fa-clock" aria-hidden="true"></i>
                                            <%= new Date(step.updatedAt).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                            <span class="tracking-time-separator">at</span>
                                            <%= new Date(step.updatedAt).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' }) %>
                                        </time>
                                        <% if (step.note) { %><p class="tracking-step-note"><%= step.note %></p><% } %>
                                    </div>
                                </li>
                            <% }) %>
                        </ol>
                    <% } else { %>
                        <div class="tracking-empty"><i class="far fa-clock" aria-hidden="true"></i><h3>No tracking updates yet</h3><p>Your order's progress will appear here as updates become available.</p></div>
                    <% } %>
                </section>
                <div class="tracking-help">
                    <div class="tracking-help-icon"><i class="fas fa-info-circle" aria-hidden="true"></i></div>
                    <div><strong>About your tracking updates</strong><p>Each event is recorded when your order status changes. Check this page for the latest available information.</p></div>
                </div>
            </div>
            <aside class="col-12 col-lg-4">
                <section class="tracking-panel tracking-details" aria-labelledby="tracking-details-heading">
                    <div class="tracking-panel-heading"><div><span class="tracking-section-kicker">AT A GLANCE</span><h2 id="tracking-details-heading">Order details</h2></div></div>
                    <div class="tracking-details-body">
                        <div class="tracking-detail-row"><span>Order number</span><strong class="tracking-order-number"><%= order.orderId %></strong></div>
                        <div class="tracking-detail-row"><span>Order date</span><strong><%= new Date(order.orderDate || order.createdAt).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) %></strong></div>
                        <div class="tracking-detail-row"><span>Payment method</span><strong><%= order.paymentMethod === 'cod' ? 'Cash on delivery' : order.paymentMethod === 'razorpay' ? 'Razorpay' : order.paymentMethod === 'wallet' ? 'Wallet' : order.paymentMethod === 'wallet with razorpay' ? 'Wallet with Razorpay' : order.paymentMethod %></strong></div>
                        <div class="tracking-detail-row"><span>Current status</span><strong><%= order.status %></strong></div>
                        <div class="tracking-detail-total"><span>Order amount</span><strong>₹<%= Number(order.orderTotal || 0).toLocaleString('en-IN') %></strong></div>
                        <a href="/orders" class="btn tracking-details-button"><i class="fas fa-list-alt" aria-hidden="true"></i> View all orders</a>
                    </div>
                </section>
            </aside>
        </div>
    </div>
</section>
<%- include("../userpartials/footer.ejs") %>
